<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:name=".FitTrackerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitTracker.Dark">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--Home Intent-->
        <!--Dash Intent-->
        <!--Exercises Intent-->
        <activity
            android:name=".ui.exercises.add.AddExerciseActivity"
            android:exported="false"
            />
        <activity
            android:name=".ui.exercises.detail.ExerciseDetailActivity"
            android:exported="false"
            />
        <activity
            android:name=".ui.exercises.detail.ExerciseDetailAcTimer"
            android:exported="false"
            />
        <activity android:name=".ui.exercises.detail.RunningActivity" />

<!--        android:theme="@style/Theme.FitTracker.NoActionBar"-->
    </application>

</manifest>